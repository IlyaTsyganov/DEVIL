<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\Assets\trigger-paths.tsv" LogicalName="Devil.TriggerPaths.tsv" />
    <Compile Include="..\..\Game\*.cs" Link="Game\%(Filename)%(Extension)" />
    <Compile Include="..\..\Configuration\*.cs" Link="Configuration\%(Filename)%(Extension)" />
    <Content Include="..\..\Native\CollisionViewer\src\native_profile.h" Link="Fixtures\native_profile.h" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
